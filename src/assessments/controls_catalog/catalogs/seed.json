      "controls": [
        {
          "control_id": "FW-RULE-PERMISSIVENESS-001",
          "name": "Ensure firewall rules are not overly permissive",
          "control_type": "security_rule",
          "description": "Firewall security policy rules should be configured to allow only the minimum required access necessary for the intended traffic flow. Rules should avoid overly broad source, destination, user, application, service, or action criteria, including unnecessary use of any, broad network ranges, unrestricted services, or excessive application allowances.",
          "rationale": "Overly permissive firewall rules increase the attack surface by allowing unnecessary network access and reducing the effectiveness of segmentation and least-privilege enforcement.",
          "audit": "Review allowed firewall security policy rules and identify rules with broad or unrestricted match criteria, including any sources, destinations, users, applications, or services, broad address objects, broad service groups, or allow actions that exceed the documented technical requirement.",
          "remediation": "Modify overly permissive rules to restrict access to the minimum required sources, destinations, users, applications, and services. Remove unused broad rules or replace them with more specific rules aligned to the intended traffic flow.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Application and service is 'any'",
              "short_description": "",
              "canonical_query": {
                "model": "integrations.SecurityRule",
                "operator": "and",
                "clauses": [
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "application",
                        "op": "eq",
                        "value": "any",
                        "negated": false,
                        "case_sensitive": false,
                        "include_any": false
                      },
                      {
                        "field": "service",
                        "op": "eq",
                        "value": "any",
                        "negated": false,
                        "case_sensitive": false,
                        "include_any": false
                      }
                    ]
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            },
            {
              "name": "Destination is 'any'",
              "short_description": "",
              "canonical_query": {
                "model": "integrations.SecurityRule",
                "operator": "and",
                "clauses": [
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "destination_address",
                        "op": "exactly",
                        "value": "any",
                        "negated": false,
                        "case_sensitive": false,
                        "include_any": true
                      }
                    ]
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            },
            {
              "name": "Source is 'any'",
              "short_description": "",
              "canonical_query": {
                "model": "integrations.SecurityRule",
                "operator": "and",
                "clauses": [
                  {
                    "operator": "or",
                    "clauses": [
                      {
                        "field": "source_address",
                        "op": "exactly",
                        "value": "any",
                        "negated": false,
                        "case_sensitive": false,
                        "include_any": true
                      }
                    ]
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            },
            {
              "name": "Destination zone internet",
              "short_description": "",
              "canonical_query": {
                "model": "integrations.SecurityRule",
                "operator": "and",
                "clauses": [
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "operator": "or",
                        "clauses": [
                          {
                            "field": "source_address",
                            "op": "exactly",
                            "value": "any",
                            "negated": false,
                            "case_sensitive": false,
                            "include_any": true
                          },
                          {
                            "field": "destination_address",
                            "op": "exactly",
                            "value": "any",
                            "negated": false,
                            "case_sensitive": false,
                            "include_any": true
                          }
                        ]
                      },
                      {
                        "operator": "and",
                        "clauses": [
                          {
                            "field": "application",
                            "op": "eq",
                            "value": "any",
                            "negated": false,
                            "case_sensitive": false,
                            "include_any": false
                          },
                          {
                            "field": "service",
                            "op": "eq",
                            "value": "any",
                            "negated": false,
                            "case_sensitive": false,
                            "include_any": false
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "to_zone",
                        "op": "eq",
                        "value": "internet",
                        "negated": false,
                        "case_sensitive": false,
                        "include_any": false
                      }
                    ]
                  }
                ]
              },
              "is_baseline": false,
              "adjusted_severity": "low",
              "is_active": true
            }
          ],
          "target_model": "integrations.SecurityRule"
        },
        {
          "control_id": "HA-001",
          "name": "Ensure High Availability is enabled where required",
          "control_type": "management_plane",
          "description": "High Availability should be enabled on firewalls that are expected to operate as part of a redundant firewall pair.",
          "rationale": "Firewalls that enforce critical network paths can become single points of failure if High Availability is not configured. Enabling HA supports service continuity during device failure, maintenance, or controlled failover events.",
          "audit": "Review the High Availability configuration and verify that HA is enabled for firewalls that require redundant operation.",
          "remediation": "Configure High Availability on the firewall pair, including HA interfaces, peer settings, HA group settings, synchronization settings, and failover monitoring appropriate to the deployment.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "and",
                "clauses": [
                  {
                    "field": "ha_required",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "field": "ha_enabled",
                    "op": "eq",
                    "value": false
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "HA-002",
          "name": "Ensure High Availability session synchronization is enabled",
          "control_type": "management_plane",
          "description": "High Availability state synchronization should be enabled for HA firewall pairs where session preservation is required during failover.",
          "rationale": "Without session synchronization, active sessions may be dropped during failover, which can disrupt business applications, user access, VPN traffic, and long-lived connections.",
          "audit": "Review the HA state synchronization setting and verify that state synchronization is enabled on both HA peers where session preservation is required.",
          "remediation": "Enable HA state synchronization and verify HA2 connectivity between peers. Confirm that both peers have consistent state synchronization settings.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "and",
                "clauses": [
                  {
                    "field": "ha_required",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "field": "ha_enabled",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "field": "ha_state_sync_enabled",
                    "op": "eq",
                    "value": false
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "HA-003",
          "name": "Ensure High Availability link monitoring is enabled where required",
          "control_type": "management_plane",
          "description": "High Availability link monitoring should be enabled for critical dataplane interfaces or interface groups where link failure should trigger HA failover.",
          "rationale": "If link monitoring is not configured, a firewall may remain active even when critical dataplane links have failed, causing traffic disruption without triggering failover to the peer device.",
          "audit": "Review the HA monitoring configuration and verify that link monitoring is enabled for critical interfaces or interface groups.",
          "remediation": "Enable HA link monitoring and define monitored link groups for critical interfaces. Configure the failure condition according to the redundancy design.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "and",
                "clauses": [
                  {
                    "field": "ha_required",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "field": "ha_enabled",
                    "op": "eq",
                    "value": true
                  },
                  {
                    "field": "ha_link_monitoring_enabled",
                    "op": "eq",
                    "value": false
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "MGMT-001",
          "name": "Ensure insecure management services are disabled",
          "control_type": "management_plane",
          "description": "Management access should use secure administrative services only. Insecure or unnecessary services such as HTTP and Telnet should be disabled on the management interface.",
          "rationale": "Unencrypted or unnecessary management services increase the risk of credential exposure, unauthorized access, and attack surface exposure on the firewall management plane.",
          "audit": "Review the management interface service settings and verify that only required secure services are enabled. HTTP and Telnet should be disabled. HTTPS and SSH may be enabled if required and restricted to trusted management sources.",
          "remediation": "Disable insecure or unnecessary management services. Retain only required secure services, such as HTTPS and SSH, and restrict access using permitted IP addresses.",
          "default_severity": "high",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "or",
                "clauses": [
                  {
                    "field": "http_disabled",
                    "op": "eq",
                    "value": false
                  },
                  {
                    "field": "telnet_disabled",
                    "op": "eq",
                    "value": false
                  },
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "https_disabled",
                        "op": "eq",
                        "value": false
                      },
                      {
                        "operator": "or",
                        "clauses": [
                          {
                            "field": "has_permitted_ip_restrictions",
                            "op": "eq",
                            "value": false
                          },
                          {
                            "field": "has_unrestricted_permitted_ips",
                            "op": "eq",
                            "value": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "ssh_disabled",
                        "op": "eq",
                        "value": false
                      },
                      {
                        "operator": "or",
                        "clauses": [
                          {
                            "field": "has_permitted_ip_restrictions",
                            "op": "eq",
                            "value": false
                          },
                          {
                            "field": "has_unrestricted_permitted_ips",
                            "op": "eq",
                            "value": true
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "operator": "and",
                    "clauses": [
                      {
                        "field": "snmp_disabled",
                        "op": "eq",
                        "value": false
                      },
                      {
                        "operator": "or",
                        "clauses": [
                          {
                            "field": "has_permitted_ip_restrictions",
                            "op": "eq",
                            "value": false
                          },
                          {
                            "field": "has_unrestricted_permitted_ips",
                            "op": "eq",
                            "value": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "MGMT-002",
          "name": "Ensure management interface permitted IP addresses are configured",
          "control_type": "management_plane",
          "description": "The firewall management interface should restrict administrative access to approved management networks or hosts.",
          "rationale": "Restricting permitted IP addresses reduces exposure of the management plane and limits administrative access attempts to trusted networks or jump hosts.",
          "audit": "Review the management interface permitted IP address list and verify that only approved administrative networks or hosts are allowed.",
          "remediation": "Configure permitted IP addresses for the management interface using approved management subnets or jump-host addresses. Avoid broad ranges unless explicitly justified.",
          "default_severity": "high",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "or",
                "clauses": [
                  {
                    "field": "has_permitted_ip_restrictions",
                    "op": "eq",
                    "value": false
                  },
                  {
                    "field": "has_unrestricted_permitted_ips",
                    "op": "eq",
                    "value": true
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "MGMT-003",
          "name": "Ensure a login banner is configured",
          "control_type": "management_plane",
          "description": "A login banner should be configured to notify users that access is restricted to authorized users and that activity may be monitored.",
          "rationale": "A login banner supports administrative accountability and provides legal or policy notice before access to the firewall management interface.",
          "audit": "Review the system login banner configuration and verify that a non-empty approved login banner is configured.",
          "remediation": "Configure an approved login banner that states authorized-use restrictions and monitoring expectations consistent with organizational policy.",
          "default_severity": "low",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "or",
                "clauses": [
                  {
                    "field": "login_banner",
                    "op": "is_empty",
                    "value": ""
                  },
                  {
                    "field": "login_banner",
                    "op": "contains",
                    "value": "placeholder"
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "MGMT-004",
          "name": "Ensure the device management idle timeout is less than or equal to 10 minutes",
          "control_type": "management_plane",
          "description": "The device management idle timeout should be configured to automatically close inactive administrative sessions after 10 minutes or less.",
          "rationale": "Inactive administrative sessions can be misused if an administrator leaves a workstation unattended. A short idle timeout reduces the opportunity for unauthorized use of an existing management session.",
          "audit": "Review the management authentication settings and verify that the idle timeout is configured to 10 minutes or less and is not set to never timeout.",
          "remediation": "Configure the management idle timeout to 10 minutes or less.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "or",
                "clauses": [
                  {
                    "field": "idle_timeout_minutes",
                    "op": "eq",
                    "value": 0
                  },
                  {
                    "field": "idle_timeout_minutes",
                    "op": "gt",
                    "value": 10
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        },
        {
          "control_id": "TIME-001",
          "name": "Ensure redundant NTP servers are configured",
          "control_type": "management_plane",
          "description": "The firewall should be configured with primary and secondary NTP servers.",
          "rationale": "Accurate and consistent time is required for reliable log correlation, event investigation, certificate validation, authentication, and forensic analysis. Redundant NTP servers reduce the risk of time drift if one time source is unavailable.",
          "audit": "Review the device service settings and verify that both primary and secondary NTP servers are configured.",
          "remediation": "Configure approved primary and secondary NTP servers for the firewall. Use internal enterprise NTP sources where available.",
          "default_severity": "medium",
          "implementation_version": "v1",
          "is_active": true,
          "queries": [
            {
              "name": "Baseline",
              "short_description": "Default management-plane baseline query.",
              "canonical_query": {
                "model": "integrations.ManagementPlaneProfile",
                "operator": "or",
                "clauses": [
                  {
                    "field": "ntp_primary_server",
                    "op": "is_empty",
                    "value": ""
                  },
                  {
                    "field": "ntp_secondary_server",
                    "op": "is_empty",
                    "value": ""
                  }
                ]
              },
              "is_baseline": true,
              "adjusted_severity": null,
              "is_active": true
            }
          ],
          "target_model": "integrations.ManagementPlaneProfile"
        }
      ]
    }
  ]
}